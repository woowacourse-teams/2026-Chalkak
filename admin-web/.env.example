# NEXT_PUBLIC_ values are embedded in the browser bundle. Never put secrets here.
# Local development uses mock mode. Vercel Preview must override this with
# NEXT_PUBLIC_API_MODE=real, the HTTPS development admin API URL, and
# NEXT_PUBLIC_APP_ENV=preview. Do not configure Production until admin auth ships.
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8080/api/v1/admin
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_APP_ENV=local
