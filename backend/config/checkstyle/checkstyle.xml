<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="TreeWalker">
        <module name="NeedBraces">
            <property name="tokens" value="LITERAL_IF,LITERAL_FOR,LITERAL_WHILE"/>
        </module>
        <module name="IllegalToken">
            <property name="tokens" value="LITERAL_ELSE,LITERAL_SWITCH"/>
        </module>
        <module name="EmptyBlock">
            <property name="option" value="statement"/>
            <property name="tokens" value="LITERAL_IF,LITERAL_FOR,LITERAL_WHILE,LITERAL_TRY,LITERAL_CATCH,LITERAL_FINALLY"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="RecordComponentName"/>
        <module name="SuppressionXpathFilter">
            <property name="file" value="${config_loc}/suppressions.xml"/>
        </module>
    </module>
</module>
