# 이 파일은 백업 전용 셸 설정이다. 앱 application.env에 합치지 않는다.
# Git 저장소 밖의 서버 보호 경로에 실제 파일을 준비하고 chmod 600으로 보호한다.
PGHOST=REPLACE_WITH_RDS_ENDPOINT
PGPORT=5432
PGDATABASE=chalkak
PGUSER=REPLACE_WITH_BACKUP_DB_USER
PGSSLROOTCERT=/etc/chalkak-backup/rds-ca.pem
PGPASSFILE=/etc/chalkak-backup/pgpass

# 팀 계정의 제한된 자격 증명. 루트 계정 접근 키를 사용하지 않는다.
RCLONE_CONFIG=/etc/chalkak-backup/rclone.conf
# remote 이름, 버킷, prefix는 팀 계정 준비 후 설정. 마지막 경로는 db.
DB_BACKUP_DESTINATION=backup:REPLACE_WITH_BACKUP_BUCKET/chalkak/db

# 여유 공간이 있는 로컬 경로. 실행마다 mode 700의 임시 디렉터리를 만든다.
DB_BACKUP_TEMP_ROOT=/tmp
