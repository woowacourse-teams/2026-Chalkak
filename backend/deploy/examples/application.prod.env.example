SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
GOOGLE_OIDC_CLIENT_ID=REPLACE_WITH_GOOGLE_OIDC_WEB_CLIENT_ID
KAKAO_OIDC_APP_KEY=REPLACE_WITH_KAKAO_NATIVE_APP_KEY
SOCIAL_SIGNUP_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
ACCESS_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
ACCESS_TOKEN_EXPIRATION=1h
ADMIN_USERNAME=operator
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
# 백엔드·Swagger 주소가 아닌, 실제 관리자 웹의 HTTPS Origin으로 교체한다.
# /posts 같은 경로나 마지막 /는 넣지 않는다.
ADMIN_CORS_ALLOWED_ORIGIN=https://REPLACE_WITH_ADMIN_WEB_DOMAIN

DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=chalkak
DB_USERNAME=REPLACE_WITH_RDS_USERNAME
DB_PASSWORD=REPLACE_WITH_RDS_PASSWORD

AWS_REGION=ap-northeast-2
S3_BUCKET=techcourse-project-2026
S3_PREFIX=chalkak
CLOUDFRONT_BASE_URL=https://REPLACE_WITH_CLOUDFRONT_DOMAIN
CLOUDFRONT_ORIGIN_PATH=/chalkak
IMAGE_PROCESSOR_CALLBACK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
POST_IMAGE_PROCESSING_TIMEOUT=7m
SIGNATURE_PROCESSING_TIMEOUT=7m
CALLBACK_MAX_BODY_BYTES=65536
