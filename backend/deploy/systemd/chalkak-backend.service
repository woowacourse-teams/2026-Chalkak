[Unit]
Description=Chalkak backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chalkak
Group=chalkak
WorkingDirectory=/opt/chalkak
EnvironmentFile=/etc/chalkak/application.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -jar /opt/chalkak/app/application.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/chalkak/logs

[Install]
WantedBy=multi-user.target
