{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/chalkak/logs/application.log",
            "log_group_name": "/chalkak/dev/application",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/opt/chalkak/logs/notification.log",
            "log_group_name": "/chalkak/dev/notification",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/opt/chalkak/logs/gc.log",
            "log_group_name": "/chalkak/dev/gc",
            "log_stream_name": "{instance_id}",
            "timestamp_format": "[%Y-%m-%dT%H:%M:%S.%f%z]",
            "timezone": "UTC"
          },
          {
            "file_path": "/opt/chalkak/logs/gc-8080.log",
            "log_group_name": "/chalkak/dev/gc",
            "log_stream_name": "{instance_id}-8080",
            "timestamp_format": "[%Y-%m-%dT%H:%M:%S.%f%z]",
            "timezone": "UTC"
          },
          {
            "file_path": "/opt/chalkak/logs/gc-8081.log",
            "log_group_name": "/chalkak/dev/gc",
            "log_stream_name": "{instance_id}-8081",
            "timestamp_format": "[%Y-%m-%dT%H:%M:%S.%f%z]",
            "timezone": "UTC"
          }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "drop_device": true
      }
    }
  }
}
