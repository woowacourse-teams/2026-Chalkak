{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/chalkak/logs/application.log",
            "log_group_name": "/chalkak/prod/application",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/opt/chalkak/logs/notification.log",
            "log_group_name": "/chalkak/prod/notification",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/opt/chalkak/logs/gc.log",
            "log_group_name": "/chalkak/prod/gc",
            "log_stream_name": "{instance_id}",
            "timestamp_format": "[%Y-%m-%dT%H:%M:%S.%f%z]",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/chalkak-memwatch.log",
            "log_group_name": "/chalkak/prod/memwatch",
            "log_stream_name": "{instance_id}",
            "timestamp_format": "%Y-%m-%dT%H:%M:%SZ",
            "timezone": "UTC"
          }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ]
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "drop_device": true
      }
    }
  }
}
