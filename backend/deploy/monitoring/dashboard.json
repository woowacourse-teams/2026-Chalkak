    {
      "type": "log",
      "x": 12,
      "y": 130,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "AI 리뷰 처리 시간 p50 / p95 (ms, 1시간)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"ai_review\" and event in [\"review_completed\", \"review_failed\"]\n| stats pct(queueWaitMs, 95) as wait_p95, pct(totalMs, 50) as total_p50, pct(totalMs, 95) as total_p95, pct(latencyMs, 50) as openai_p50, pct(latencyMs, 95) as openai_p95 by bin(1h)"
      }
    },
