    {
      "type": "text",
      "x": 0,
      "y": 65,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# 원인 분석 (prod 애플리케이션 로그)"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 66,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "라우트별 p95 지연 시간 상위 10 (ms)",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"access\"\n| stats pct(durationMs,95) as p95, count(*) as n by route\n| sort p95 desc\n| limit 10"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 66,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "최근 5xx 20건",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"error\" and status >= 500\n| fields @timestamp, requestId, errorCode, stack_trace\n| sort @timestamp desc\n| limit 20"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 72,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "401/403 시간별 라우트 집계",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"access\" and status in [401,403]\n| stats count(*) as n by bin(1h) as hour, route, status\n| sort hour desc\n| limit 50"
      }
    }
  ]
}
