{
  "start": "-PT24H",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# prod 상태"
      }
    },
    {
      "type": "alarm",
      "x": 0,
      "y": 1,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "prod 알람",
        "sortBy": "stateUpdatedTimestamp",
        "alarms": [
          "arn:aws:cloudwatch:ap-northeast-2:843255971531:alarm:chalkak-prod-5xx",
          "arn:aws:cloudwatch:ap-northeast-2:843255971531:alarm:chalkak-prod-ec2-status-check",
          "arn:aws:cloudwatch:ap-northeast-2:843255971531:alarm:chalkak-prod-disk-used",
          "arn:aws:cloudwatch:ap-northeast-2:843255971531:alarm:chalkak-prod-memory-used",
          "arn:aws:cloudwatch:ap-northeast-2:843255971531:alarm:chalkak-prod-rds-free-storage",
          "arn:aws:cloudwatch:ap-northeast-2:843255971531:alarm:chalkak-prod-no-open-topic"
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 1,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "prod 요청 수 / 5xx (5분)",
        "view": "timeSeries",
        "region": "ap-northeast-2",
        "period": 300,
        "metrics": [
          [
            "Chalkak/prod",
            "RequestCount",
            {
              "stat": "Sum",
              "label": "요청 수"
            }
          ],
          [
            "Chalkak/prod",
            "Server5xx",
            {
              "stat": "Sum",
              "label": "5xx",
              "yAxis": "right"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 7,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "prod 지연 시간 p95 / p99 (ms)",
        "view": "timeSeries",
        "region": "ap-northeast-2",
        "period": 300,
        "metrics": [
          [
            "Chalkak/prod",
            "LatencyMs",
            {
              "stat": "p95",
              "label": "p95"
            }
          ],
          [
            "Chalkak/prod",
            "LatencyMs",
            {
              "stat": "p99",
              "label": "p99"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 7,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "prod EC2 CPU (%)",
        "view": "timeSeries",
        "region": "ap-northeast-2",
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/EC2",
            "CPUUtilization",
            "InstanceId",
            "PROD_INSTANCE_ID"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 7,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "prod 메모리 / 디스크 사용률 (%)",
        "view": "timeSeries",
        "region": "ap-northeast-2",
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "CWAgent",
            "mem_used_percent",
            "InstanceId",
            "PROD_INSTANCE_ID",
            {
              "label": "메모리"
            }
          ],
          [
            "CWAgent",
            "disk_used_percent",
            "InstanceId",
            "PROD_INSTANCE_ID",
            "path",
            "/",
            "fstype",
            "ext4",
            {
              "label": "디스크 /"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 13,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "prod RDS CPU (%) / 연결 수",
        "view": "timeSeries",
        "region": "ap-northeast-2",
        "period": 300,
        "stat": "Average",
        "metrics": [
          [
            "AWS/RDS",
            "CPUUtilization",
            "DBInstanceIdentifier",
            "PROD_RDS_INSTANCE_ID",
            {
              "label": "CPU (%)"
            }
          ],
          [
            "AWS/RDS",
            "DatabaseConnections",
            "DBInstanceIdentifier",
            "PROD_RDS_INSTANCE_ID",
            {
              "label": "연결 수",
              "yAxis": "right"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 13,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "prod RDS 여유 스토리지 (bytes)",
        "view": "timeSeries",
        "region": "ap-northeast-2",
        "period": 300,
        "stat": "Minimum",
        "metrics": [
          [
            "AWS/RDS",
            "FreeStorageSpace",
            "DBInstanceIdentifier",
            "PROD_RDS_INSTANCE_ID"
          ]
        ]
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 19,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# prod 운영·사용자\nLogs Insights 위젯은 대시보드 기간(기본 24시간)을 따릅니다. DAU 추이와 검수 소요 시간 추이는 대시보드 기간을 8주로 바꿔서 확인하세요. 기간이 길수록 조회 비용이 늘어납니다. 일별 집계는 UTC 자정(한국 시각 오전 9시) 기준입니다. 검수 대기 목록은 조회 기간 안에 접수된 게시물만 보이므로, 정확한 대기 현황은 관리자 페이지에서 확인하세요."
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "JVM 힙 사용량 / 최대 (MB)",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"runtime\"\n| stats max(heapUsedBytes/1048576) as heapUsedMB, max(heapMaxBytes/1048576) as heapMaxMB by bin(5m)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 21,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "스레드 수 / Hikari 활성·대기 커넥션",
        "region": "ap-northeast-2",
        "view": "timeSeries",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"runtime\"\n| stats max(threads) as threads, max(hikariActive) as hikariActive, max(hikariPending) as hikariPending by bin(5m)"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 27,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "검수 소요 시간 (일별 평균 / p95, 초)",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"moderation\" and event in [\"approved\",\"rejected\"]\n| stats avg(waitSeconds) as avgWaitSec, pct(waitSeconds, 95) as p95WaitSec, count(*) as n by bin(1d) as day\n| sort day desc"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 27,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "조회 기간 안에 접수된 검수 대기 중 오래된 게시물 (최대 10건)",
        "region": "ap-northeast-2",
        "view": "table",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"moderation\"\n| stats latest(event) as last, min(@timestamp) as since by postId\n| filter last = \"pending\"\n| sort since asc\n| limit 10"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 33,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "DAU (로그인 회원, 일별)",
        "region": "ap-northeast-2",
        "view": "bar",
        "query": "SOURCE '/chalkak/prod/application' | filter type=\"access\" and ispresent(userId) and status < 400\n| stats countDistinct(userId) as dau by bin(1d)"
      }
    },
    {
      "type": "text",
      "x": 0,
      "y": 39,
      "width": 24,
      "height": 1,
      "properties": {
