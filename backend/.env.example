POSTGRES_DB=chalkak
POSTGRES_USER=chalkak
POSTGRES_PASSWORD=local-password
POSTGRES_PORT=5432

TEST_POSTGRES_DB=chalkak_test
TEST_POSTGRES_USER=chalkak
TEST_POSTGRES_PASSWORD=test-password
TEST_POSTGRES_PORT=5433

# Google OIDC 백엔드용 Web Client ID.
GOOGLE_OIDC_CLIENT_ID=REPLACE_WITH_GOOGLE_OIDC_WEB_CLIENT_ID

# Kakao OIDC 모바일 SDK에서 공통으로 사용하는 네이티브 앱 키.
KAKAO_OIDC_APP_KEY=REPLACE_WITH_KAKAO_NATIVE_APP_KEY

# 소셜 회원가입 토큰 HS256 서명 키. openssl rand -hex 32로 생성한다.
SOCIAL_SIGNUP_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# 액세스 토큰 HS256 서명 키. openssl rand -hex 32로 생성한다.
# 회원가입 토큰과 반드시 다른 값을 사용한다.
ACCESS_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# 차단 소셜 계정 식별자 HMAC 키. openssl rand -hex 32로 생성한다.
# 액세스 토큰 및 회원가입 토큰 키와 반드시 다른 값을 사용한다.
SOCIAL_IDENTITY_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# 액세스 토큰 만료 시간. 이 시간이 지나면 사용자가 다시 로그인해야 한다.
# 30m, 1h, PT1H 형식을 모두 받는다.
ACCESS_TOKEN_EXPIRATION=15m

# 로컬 관리자 인증. 실제 로그인을 검증할 때 false로 바꾸고 아래 계정을 설정한다.
# true는 기존 개발용 고정 관리자 우회를 유지한다. dev/prod에는 이 키를 추가하지 않는다.
ADMIN_DEVELOPMENT_BYPASS_ENABLED=true
ADMIN_USERNAME=operator
# htpasswd -nBC 12 operator로 생성한 결과에서 콜론 뒤의 BCrypt 해시만 넣는다.
# 평문 비밀번호를 넣지 않는다. 해시의 $ 문자는 그대로 입력한다.
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# 관리자 검수 Slack 알림. false로 두면 Slack 알림을 전송하지 않는다.
# true로 바꿀 때는 Webhook과 ADMIN_WEB_BASE_URL도 실제 HTTPS 주소로 교체한다.
ADMIN_NOTIFICATION_DELIVERY_ENABLED=false
# Slack Incoming Webhook 비밀값. 실제 값은 저장소에 커밋하지 않는다.
ADMIN_SLACK_WEBHOOK_URL=https://REPLACE_WITH_SLACK_WEBHOOK_URL
# Slack 알림에서 게시물 검수 화면으로 이동할 관리자 웹 Origin.
ADMIN_WEB_BASE_URL=http://localhost:3000

# S3 이미지 저장소.
S3_BUCKET=techcourse-project-2026
AWS_REGION=ap-northeast-2
S3_PREFIX=chalkak
CLOUDFRONT_BASE_URL=https://REPLACE_WITH_CLOUDFRONT_DOMAIN
CLOUDFRONT_ORIGIN_PATH=/chalkak

# Lambda 이미지 처리 완료·실패 콜백 HMAC 비밀키.
# 백엔드와 Lambda에 같은 최소 32자 이상의 임의 값을 설정한다.
IMAGE_PROCESSOR_CALLBACK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# 이미지 처리 완료 콜백을 기다리는 시간. 이 시간을 넘긴 검수 대기 게시물은
# 다음 게시물 생성 시점에 거절 처리해 작성자가 같은 주제에 다시 올릴 수 있게 한다.
# 7m, 1h, PT7M 형식을 모두 받는다.
POST_IMAGE_PROCESSING_TIMEOUT=7m

# 사인 처리 완료 콜백을 기다리는 시간. 이 시간을 넘기면 재등록이 필요하며,
# 이후 도착한 성공 콜백은 무시한다. 7m, 1h, PT7M 형식을 모두 받는다.
SIGNATURE_PROCESSING_TIMEOUT=7m

# 이미지 처리 콜백 본문 상한(바이트). @RequestBody는 컨트롤러보다 먼저 채워져
# 본문이 HMAC 검증보다 앞서 메모리에 올라가므로, 인증 이전 단계에서 끊는다.
CALLBACK_MAX_BODY_BYTES=65536
