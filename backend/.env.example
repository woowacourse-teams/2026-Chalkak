POSTGRES_DB=chalkak
POSTGRES_USER=chalkak
POSTGRES_PASSWORD=local-password
POSTGRES_PORT=5432

TEST_POSTGRES_DB=chalkak_test
TEST_POSTGRES_USER=chalkak
TEST_POSTGRES_PASSWORD=test-password
TEST_POSTGRES_PORT=5433

# Google OIDC 백엔드용 Web Client ID.
GOOGLE_OIDC_CLIENT_ID=REPLACE_WITH_GOOGLE_OIDC_WEB_CLIENT_ID

# S3 이미지 저장소.
S3_BUCKET=techcourse-project-2026
AWS_REGION=ap-northeast-2
S3_PREFIX=chalkak
CLOUDFRONT_BASE_URL=https://REPLACE_WITH_CLOUDFRONT_DOMAIN
CLOUDFRONT_ORIGIN_PATH=/chalkak

# Lambda 이미지 처리 완료·실패 콜백 HMAC 비밀키.
# 백엔드와 Lambda에 같은 최소 32자 이상의 임의 값을 설정한다.
IMAGE_PROCESSOR_CALLBACK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
