# 필터 워커 환경 파일 예시. /etc/chalkak/filter-worker.env (root:root 600)로 설치한다.
# 값은 자리표시다. 실제 값은 #1026에서 채운다. 자리표시 그대로 시작하면 설정 검증에서 종료 코드 78로 끝나고 재시작하지 않는다.
# AWS 자격 증명은 넣지 않는다(EC2 인스턴스 역할을 쓴다).

# 필수: 추출 요청 큐 URL (dev·prod 공용)
FILTER_EXTRACTION_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<계정ID>/chalkak-filter-extraction
# 필수: SDK는 EC2 메타데이터에서 리전을 읽지 않는다
AWS_REGION=ap-northeast-2

# 견본·레시피 버킷과 접두사 (기본값 techcourse-project-2026, chalkak)
S3_BUCKET=techcourse-project-2026
S3_PREFIX=chalkak

# 필수: 환경별 백엔드 내부 API 기준 URL. 경로는 정확히 /internal/v1, https만(루프백 주소는 http 허용)
DEV_BACKEND_INTERNAL_API_BASE_URL=https://<dev API 도메인>/internal/v1
PROD_BACKEND_INTERNAL_API_BASE_URL=https://<prod API 도메인>/internal/v1

# 필수: 백엔드 IMAGE_PROCESSOR_CALLBACK_SECRET과 같은 값(32자 이상)
IMAGE_PROCESSING_API_SECRET=<백엔드 IMAGE_PROCESSOR_CALLBACK_SECRET과 같은 값>

# 선택(괄호 안이 기본값)
# 콜백 HTTP 요청 하나의 제한 시간 초 (5)
CALLBACK_TIMEOUT_SECONDS=5
# 수신 횟수가 이 값 이상이면 추출하지 않고 failed로 포기 (5)
SQS_MAX_RECEIVE_COUNT=5
# 추출 제한 시간 초. 넘으면 재시도 없이 failed (480)
EXTRACTION_TIMEOUT_SECONDS=480
# 숨김 시간 연장 주기 초. 연장 값의 절반보다 작아야 한다 (60)
HEARTBEAT_INTERVAL_SECONDS=60
# 연장할 때 설정하는 숨김 시간 초, 1~43200 (180)
VISIBILITY_EXTENSION_SECONDS=180
# 작업 폴더. systemd 유닛이 /var/cache/chalkak-filter-worker로 정하므로 서비스에서는 쓰지 않는다 (기본 os.tmpdir())
# FILTER_WORKER_WORK_DIR=
