# S3 입력 객체
S3_BUCKET=techcourse-project-2026
S3_PREFIX=chalkak

# 사인 이미지 처리 제한
SIGNATURE_MAX_BYTES=1048576
SIGNATURE_MAX_PIXELS=25000000
SIGNATURE_THUMBNAIL_MAX_SIZE=512

# 포스트 이미지 처리 제한
POST_MAX_BYTES=5242880
POST_MAX_PIXELS=25000000
POST_THUMBNAIL_MAX_SIZE=1080
POST_WEBP_QUALITY=85
POST_THUMBNAIL_WEBP_QUALITY=80
POST_METADATA_MAX_BYTES=8192

# 백엔드 이미지 처리 내부 API. /internal/v1까지 포함한다.
DEV_BACKEND_IMAGE_PROCESSING_API_BASE_URL=https://REPLACE_WITH_DEV_API_DOMAIN/internal/v1
PROD_BACKEND_IMAGE_PROCESSING_API_BASE_URL=https://REPLACE_WITH_PROD_API_DOMAIN/internal/v1

# 백엔드 IMAGE_PROCESSOR_CALLBACK_SECRET과 동일한 값을 입력한다.
IMAGE_PROCESSING_API_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
IMAGE_PROCESSING_API_TIMEOUT_SECONDS=3

# SQS 재시도 처리
SQS_PARTIAL_BATCH_RESPONSE=false
SQS_MAX_RECEIVE_COUNT=5
