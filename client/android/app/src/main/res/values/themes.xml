<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chalkak.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#2B2724</item>
        <item name="android:navigationBarColor">@color/chalkak_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/chalkak_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Chalkak" parent="Theme.Chalkak.Base" />

    <style name="Theme.Chalkak.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/chalkak_logo_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/chalkak_logo_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/chalkak_logo_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Chalkak</item>
    </style>

    <style name="Theme.Chalkak.TimePickerSpinner" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#2B2724</item>
        <item name="android:timePickerStyle">@style/Widget.Chalkak.TimePickerSpinner</item>
    </style>

    <style name="Widget.Chalkak.TimePickerSpinner" parent="android:style/Widget.Material.Light.TimePicker">
        <item name="android:timePickerMode">spinner</item>
    </style>
</resources>
